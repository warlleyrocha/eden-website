---
import type { Translations } from "../../translations";

interface Props {
  t: Translations["services"];
}

const { t } = Astro.props;
const totalServices = t.items.length;
---

<section id="services">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <div>
        <div class="eyebrow" id="svc-eyebrow">{t.eyebrow}</div>
        <h2 id="svc-title" style="margin-top:12px">{t.title}</h2>
      </div>
      <p class="aside" id="svc-aside">{t.aside}</p>
    </div>
    <div class="services" id="services-grid">
      {t.items.map((item) => (
        <article class="svc glass" data-reveal>
          <div class="svc-num">{item.n} / {String(totalServices).padStart(2, "0")}</div>
          <h3>{item.t}</h3>
          <p>{item.d}</p>
          <ul>{item.tags.map((tag) => <li>{tag}</li>)}</ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .section-head {
    display: flex; align-items: end; justify-content: space-between;
    gap: var(--s-6);
    margin-bottom: var(--s-8);
  }
  @media (max-width: 720px) {
    .section-head { flex-direction: column; align-items: start; }
  }
  .section-head h2 { max-width: 18ch; }
  .section-head .aside { color: var(--text-dim); max-width: 40ch; font-size: 15px; }

  .services {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-4);
  }
  @media (max-width: 960px) { .services { grid-template-columns: 1fr; } }
  .svc {
    padding: var(--s-5);
    display: flex; flex-direction: column;
    min-height: 280px;
    position: relative; overflow: hidden;
    transition: transform .3s, border-color .3s;
  }
  .svc:hover { transform: translateY(-4px); border-color: var(--stroke-strong); }
  .svc-num {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-mute);
  }
  .svc h3 { margin-top: var(--s-3); font-size: 22px; letter-spacing: -0.02em; }
  .svc p { margin-top: var(--s-3); color: var(--text-dim); font-size: 14.5px; }
  .svc ul {
    margin-top: var(--s-4);
    display: flex; flex-wrap: wrap; gap: 4px;
    list-style: none;
  }
  .svc li {
    padding: 3px 8px;
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    background: var(--glass-bg);
    color: var(--text-dim);
    border: 1px solid var(--stroke-soft);
  }
</style>
