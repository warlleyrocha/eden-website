---
import type { Translations } from "../../translations";

interface Props {
  t: Translations["about"];
}

const { t } = Astro.props;
---

<section id="about">
  <div class="wrap">
    <div class="about-grid">
      <div class="about-text" data-reveal>
        <div class="eyebrow" id="about-eyebrow">{t.eyebrow}</div>
        <h2 id="about-title" style="margin-top:12px">{t.title}</h2>
        <p id="about-p1">{t.p1}</p>
        <p id="about-p2">{t.p2}</p>
        <div class="about-stats" id="about-stats">
          <div class="stat-card glass"><div class="big">{t.s1n}</div><div class="label">{t.s1l}</div></div>
          <div class="stat-card glass"><div class="big">{t.s2n}</div><div class="label">{t.s2l}</div></div>
          <div class="stat-card glass"><div class="big">{t.s3n}</div><div class="label">{t.s3l}</div></div>
          <div class="stat-card glass"><div class="big"><span class="u">{t.s4n}</span></div><div class="label">{t.s4l}</div></div>
        </div>
      </div>
      <div class="about-visual glass" data-reveal>
        <div class="arch-layer l-backend"><span class="arch-label">backend</span></div>
        <div class="arch-layer l-web"><span class="arch-label">web</span></div>
        <div class="arch-layer l-mobile"><span class="arch-label">mobile</span></div>
        <div class="arch-connector"></div>
        <div class="arch-connector c2"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-6);
    align-items: center;
  }
  @media (max-width: 1000px) { .about-grid { grid-template-columns: 1fr; } }
  .about-text { min-width: 0; }
  .about-text p { color: var(--text-dim); font-size: 16px; margin-top: var(--s-4); max-width: 50ch; }
  .about-stats {
    display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-3);
    margin-top: var(--s-6);
  }
  .stat-card { padding: var(--s-4); border-radius: var(--r-md); }
  .stat-card .big { font-size: 34px; font-weight: 500; letter-spacing: -0.02em; line-height: 1; }
  .stat-card .big .u { color: var(--brand-2); font-family: var(--font-display); font-style: italic; }
  .stat-card .label {
    color: var(--text-mute); font-family: var(--font-mono); font-size: 11px;
    margin-top: 8px; text-transform: uppercase; letter-spacing: 0.08em;
  }

  .about-visual {
    padding: var(--s-5);
    border-radius: var(--r-xl);
    aspect-ratio: 1 / 0.85;
    position: relative;
    overflow: hidden;
  }

  .arch-layer {
    position: absolute;
    border-radius: 14px;
    border: 1px solid var(--stroke);
    display: flex;
    align-items: flex-end;
    padding: 12px 16px;
    transition: transform 0.4s ease;
  }
  .arch-layer:hover {
    transform: translateY(-4px);
  }
  .l-backend {
    inset: 52% 8% 8% 8%;
    background: color-mix(in srgb, var(--brand-deep) 12%, transparent);
    border-color: color-mix(in srgb, var(--brand-deep) 35%, transparent);
    z-index: 1;
  }
  .l-web {
    inset: 32% 14% 22% 14%;
    background: color-mix(in srgb, var(--brand) 10%, transparent);
    border-color: color-mix(in srgb, var(--brand) 30%, transparent);
    z-index: 2;
  }
  .l-mobile {
    inset: 12% 20% 42% 20%;
    background: color-mix(in srgb, var(--brand-2) 10%, transparent);
    border-color: color-mix(in srgb, var(--brand-2) 30%, transparent);
    z-index: 3;
  }
  .arch-label {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-mute);
    letter-spacing: 0.08em;
  }
  .l-mobile .arch-label {
    color: var(--brand-2);
  }
  .arch-connector {
    position: absolute;
    left: 50%;
    width: 1px;
    background: linear-gradient(to bottom, transparent, var(--stroke) 40%, var(--stroke) 60%, transparent);
    top: 12%;
    bottom: 52%;
    z-index: 0;
    transform: translateX(-50%);
  }
  .arch-connector.c2 {
    top: 32%;
    bottom: 22%;
  }
</style>
