---
import type { Translations } from "../../translations";

interface Props {
  t: Translations["hero"];
}

const { t } = Astro.props;
---

<header class="hero" id="hero">
  <div class="wrap hero-inner">
    <div>
      <div class="chip" id="hero-badge-wrap">
        <span class="dot"></span>
        <span id="hero-badge" class="mono">{t.badge}</span>
      </div>
      <h1 id="hero-title" style="margin-top:24px">
        {t.title1}<br />{t.title2} <span class="serif">{t.title3}</span>
      </h1>
      <p id="hero-sub" class="hero-sub">{t.sub}</p>
      <div class="hero-cta">
        <a href="#cta" id="hero-primary" class="btn btn-primary">{t.primary} <span class="btn-arrow">→</span></a>
        <a href="#cases" id="hero-secondary" class="btn btn-ghost">{t.secondary}</a>
      </div>
    </div>

    <div class="hero-visual">
      <div class="hero-card stat glass">
        <span class="pulse"></span>
        <span>build #2.847 <span style="color:var(--text-mute)">· passed in</span> 42s</span>
      </div>

      <div class="hero-card terminal glass-strong">
        <div class="terminal-bar">
          <span class="tc r"></span><span class="tc y"></span><span class="tc g"></span>
          <span class="t-title">eden@core ~ /deploy</span>
        </div>
        <div class="terminal-body">
          <div><span class="prompt">eden ▸</span> <span class="cmd">deploy</span> <span class="str">core-api</span> <span class="kw">--env</span> <span class="str">production</span></div>
          <div class="comment"># provisioning edge nodes across 3 regions</div>
          <div><span class="ok">✓</span> <span>dependencies</span> <span style="color:var(--text-mute)">resolved in <span class="num">1.4s</span></span></div>
          <div><span class="ok">✓</span> <span>tests</span> <span style="color:var(--text-mute)"><span class="num">2,184</span> passed · <span class="num">0</span> failed</span></div>
          <div><span class="ok">✓</span> <span>build</span> <span style="color:var(--text-mute)"><span class="num">14.2</span>mb · tree-shaken</span></div>
          <div><span class="ok">✓</span> <span>migrations</span> <span style="color:var(--text-mute)"><span class="num">3</span> applied</span></div>
          <div><span class="ok">✓</span> <span>rollout</span> <span style="color:var(--text-mute)">gradual <span class="num">10</span>→<span class="num">100</span>%</span></div>
          <div style="margin-top:8px"><span class="prompt">eden ▸</span> <span class="cmd">watch</span> metrics<span class="caret"></span></div>
        </div>
      </div>

      <div class="hero-card arch glass">
        <div class="hero-card arch-title mono">
          <span style="color:var(--brand-2)">◊</span>
          <span>architecture.yaml</span>
        </div>
        <div class="arch-diagram">
          <div class="arch-node">client · edge<span class="lat">12ms</span></div>
          <div class="arch-connector"></div>
          <div class="arch-node active">gateway · go<span class="lat">3ms</span></div>
          <div class="arch-connector"></div>
          <div class="arch-node">services · k8s<span class="lat">8ms</span></div>
          <div class="arch-connector"></div>
          <div class="arch-node">postgres · redis<span class="lat">1ms</span></div>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .hero { padding-top: calc(var(--s-16) + 20px); padding-bottom: var(--s-10); }
  .hero-inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--s-8);
    align-items: center;
  }
  @media (max-width: 960px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-visual { display: none; }
  }
  .hero-sub {
    margin-top: var(--s-5);
    font-size: clamp(16px, 1.3vw, 19px);
    color: var(--text-dim);
    max-width: 52ch;
  }
  .hero-cta {
    display: flex; flex-wrap: wrap; gap: var(--s-3);
    margin-top: var(--s-6);
  }
  .hero-meta {
    margin-top: var(--s-8);
    display: flex; gap: var(--s-6);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-mute);
  }
  .hero-meta b {
    color: var(--text); font-weight: 500; font-size: 20px;
    display: block; font-family: var(--font-sans);
  }

  .hero-visual { position: relative; height: 520px; }
  .hero-card {
    position: absolute;
    padding: var(--s-4);
    border-radius: var(--r-lg);
  }
  .hero-card.terminal {
    inset: 40px 40px 120px 0;
    padding: 0;
    overflow: hidden;
    transform: perspective(1200px) rotateY(-6deg) rotateX(3deg);
    transition: transform 0.5s cubic-bezier(.2,.8,.2,1);
  }
  .hero-card.terminal:hover {
    transform: perspective(1200px) rotateY(-3deg) rotateX(1deg) translateY(-6px);
  }
  .terminal-bar {
    display: flex; align-items: center; gap: 6px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--stroke);
    background: var(--glass-bg);
  }
  .terminal-bar .tc { width: 10px; height: 10px; border-radius: 50%; background: var(--stroke-strong); }
  .terminal-bar .tc.r { background: oklch(0.65 0.18 20); }
  .terminal-bar .tc.y { background: oklch(0.78 0.15 85); }
  .terminal-bar .tc.g { background: oklch(0.72 0.17 150); }
  .terminal-bar .t-title {
    flex: 1; text-align: center;
    font-family: var(--font-mono); font-size: 11px; color: var(--text-mute);
  }
  .terminal-body {
    padding: 16px 18px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.75;
    color: var(--text-dim);
    min-height: 280px;
  }
  .terminal-body .prompt { color: var(--brand-2); }
  .terminal-body .cmd { color: var(--text); }
  .terminal-body .comment { color: var(--text-mute); }
  .terminal-body .str { color: oklch(0.78 0.15 150); }
  .terminal-body .kw { color: oklch(0.78 0.18 320); }
  .terminal-body .num { color: oklch(0.78 0.15 60); }
  .terminal-body .ok { color: oklch(0.72 0.17 150); }
  .caret {
    display: inline-block; width: 7px; height: 14px;
    background: var(--brand-2); vertical-align: -2px;
    animation: blink 1s steps(2) infinite;
    margin-left: 2px;
  }
  @keyframes blink { 50% { opacity: 0; } }

  .hero-card.arch {
    right: 0; bottom: 0;
    width: 280px;
    padding: var(--s-4);
    transform: perspective(1200px) rotateY(-4deg) rotateX(2deg) translateX(10px);
  }
  .hero-card.arch-title {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-mute);
    display: flex; align-items: center; gap: 6px;
    margin-bottom: 10px;
  }
  .arch-diagram {
    display: flex; flex-direction: column; gap: 6px;
    font-family: var(--font-mono);
    font-size: 10.5px;
  }
  .arch-node {
    padding: 8px 10px;
    border-radius: 8px;
    background: var(--glass-bg);
    border: 1px solid var(--stroke);
    display: flex; align-items: center; justify-content: space-between;
    color: var(--text-dim);
  }
  .arch-node .lat { color: var(--text-mute); font-size: 9px; }
  .arch-node.active {
    background: color-mix(in oklch, var(--brand) 15%, transparent);
    border-color: color-mix(in oklch, var(--brand) 40%, transparent);
    color: var(--text);
  }
  .arch-connector {
    width: 1px; height: 10px;
    background: var(--stroke-strong);
    margin: 0 auto;
  }

  .hero-card.stat {
    top: 0; right: 30px;
    padding: 12px 16px;
    display: flex; align-items: center; gap: 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-dim);
  }
  .hero-card.stat .pulse {
    width: 8px; height: 8px; border-radius: 50%;
    background: oklch(0.72 0.17 150);
    box-shadow: 0 0 0 0 oklch(0.72 0.17 150 / 0.6);
    animation: pulse 2s infinite;
    flex-shrink: 0;
  }
  @keyframes pulse {
    70% { box-shadow: 0 0 0 10px oklch(0.72 0.17 150 / 0); }
    100% { box-shadow: 0 0 0 0 oklch(0.72 0.17 150 / 0); }
  }
</style>
