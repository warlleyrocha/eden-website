---
import type { Translations } from "../../translations";

interface Props {
  t: Translations["team"];
}

const { t } = Astro.props;
---

<section id="team">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <div>
        <div class="eyebrow" id="team-eyebrow">{t.eyebrow}</div>
        <h2 id="team-title" style="margin-top:12px">{t.title}</h2>
      </div>
      <p class="aside" id="team-aside">{t.aside}</p>
    </div>
    <div class="team-grid" id="team-grid">
      {t.members.map((m) => (
        <article class="person glass" data-reveal>
          <div class="avatar">
            {m.photo
              ? <img class="avatar-photo" src={m.photo} alt={m.n} loading="lazy" decoding="async" />
              : m.i}
          </div>
          <div>
            <div class="name">{m.n}</div>
            <div class="role">{m.r}</div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .section-head {
    display: flex; align-items: end; justify-content: space-between;
    gap: var(--s-6);
    margin-bottom: var(--s-8);
  }
  @media (max-width: 720px) {
    .section-head { flex-direction: column; align-items: start; }
  }
  .section-head h2 { max-width: 18ch; }
  .section-head .aside { color: var(--text-dim); max-width: 40ch; font-size: 15px; }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--s-4);
  }
  @media (max-width: 900px) { .team-grid { grid-template-columns: repeat(2, 1fr); } }
  .person {
    padding: var(--s-4);
    display: flex; flex-direction: column;
    gap: var(--s-3);
    transition: transform .3s;
  }
  .person:hover { transform: translateY(-4px); }
  .avatar {
    aspect-ratio: 1;
    border-radius: var(--r-md);
    background: linear-gradient(
      135deg,
      color-mix(in oklch, var(--brand) 30%, var(--bg-1)),
      color-mix(in oklch, var(--brand-2) 20%, var(--bg-1))
    );
    border: 1px solid var(--stroke);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 48px;
    color: var(--text);
    position: relative; overflow: hidden;
    isolation: isolate;
  }
  .avatar-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: inherit;
    position: relative;
    z-index: 1;
  }
  .avatar::after {
    content: ""; position: absolute; inset: 0;
    background: radial-gradient(circle at 30% 20%, var(--glass-highlight), transparent 50%);
    z-index: 2;
    pointer-events: none;
  }
  .person .name { font-weight: 500; font-size: 16px; }
  .person .role { font-family: var(--font-mono); font-size: 11px; color: var(--text-mute); }
</style>
