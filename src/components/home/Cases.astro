---
import type { Translations } from "../../translations";

interface Props {
  t: Translations["cases"];
}

const { t } = Astro.props;
---

<section id="cases">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <div>
        <div class="eyebrow" id="cases-eyebrow">{t.eyebrow}</div>
        <h2 id="cases-title" style="margin-top:12px">{t.title}</h2>
      </div>
    </div>
    <div class="cases" id="cases-grid">
      {t.items.map((item) => (
        <article class={`case ${item.size} glass`} data-reveal>
          <div>
            <div class="case-industry">{item.industry}</div>
            <h3>{item.t}</h3>
            <p class="desc">{item.d}</p>
          </div>
          {item.metrics && (
            <div class="case-metrics">
              {item.metrics.map((m) => (
                <div class="case-metric">
                  <div class="n">{m.n}</div>
                  <div class="l">{m.l}</div>
                </div>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .section-head {
    display: flex; align-items: end; justify-content: space-between;
    gap: var(--s-6);
    margin-bottom: var(--s-8);
  }
  .section-head h2 { max-width: 18ch; }

  .cases {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--s-4);
  }
  .case {
    padding: var(--s-5);
    display: flex; flex-direction: column; justify-content: space-between;
    gap: var(--s-6);
    min-height: 300px;
    position: relative; overflow: hidden;
    transition: transform .3s;
  }
  .case:hover { transform: translateY(-4px); }
  .case.lg { grid-column: span 7; }
  .case.sm { grid-column: span 5; }
  .case.third { grid-column: span 4; min-height: 260px; }
  @media (max-width: 900px) {
    .case.lg, .case.sm, .case.third { grid-column: 1 / -1; }
  }
  .case-industry {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-mute);
    text-transform: uppercase; letter-spacing: 0.08em;
  }
  .case h3 { margin-top: var(--s-3); font-size: 26px; max-width: 20ch; }
  .case .desc { color: var(--text-dim); margin-top: var(--s-3); font-size: 14.5px; max-width: 40ch; }
  .case-metrics { display: flex; gap: var(--s-5); flex-wrap: wrap; }
  .case-metric .n { font-size: 26px; font-weight: 500; letter-spacing: -0.02em; }
  .case-metric .l {
    font-family: var(--font-mono); font-size: 10.5px;
    color: var(--text-mute); text-transform: uppercase; letter-spacing: 0.08em;
  }
</style>
