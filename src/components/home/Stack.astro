---
import type { Translations } from "../../translations";

interface Props {
  t: Translations["stack"];
}

const { t } = Astro.props;
---

<section id="stack">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <div>
        <div class="eyebrow" id="stack-eyebrow">{t.eyebrow}</div>
        <h2 id="stack-title" style="margin-top:12px">{t.title}</h2>
      </div>
      <p class="aside" id="stack-aside">{t.aside}</p>
    </div>
    <div class="stack-grid" id="stack-grid">
      <div class="arch-benefits">
        {t.benefits.map((b) => (
          <div class="arch-benefit glass" data-reveal>
            <div class="arch-benefit-icon">{b.icon}</div>
            <h3>{b.t}</h3>
            <p>{b.d}</p>
          </div>
        ))}
      </div>
      <div class="arch-tech-footer" data-reveal>
        <span class="arch-tech-label">{t.techLabel}:</span>
        {t.techItems.map((tech) => <span class="arch-tech-tag">{tech}</span>)}
      </div>
    </div>
  </div>
</section>

<style>
  .section-head {
    display: flex; align-items: end; justify-content: space-between;
    gap: var(--s-6);
    margin-bottom: var(--s-8);
  }
  @media (max-width: 720px) {
    .section-head { flex-direction: column; align-items: start; }
  }
  .section-head h2 { max-width: 18ch; }
  .section-head .aside { color: var(--text-dim); max-width: 40ch; font-size: 15px; }

  .stack-grid {
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }
  .arch-benefits {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-4);
  }
  @media (max-width: 640px) { .arch-benefits { grid-template-columns: 1fr; } }

  .arch-benefit {
    padding: 28px 24px;
    border-radius: var(--r-md);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .arch-benefit-icon {
    font-size: 20px;
    color: var(--brand-2);
    line-height: 1;
  }
  .arch-benefit h3 {
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
    margin: 0;
  }
  .arch-benefit p {
    font-size: 14px;
    color: var(--text-dim);
    margin: 0;
    line-height: 1.65;
  }

  .arch-tech-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding-top: var(--s-4);
    border-top: 1px solid var(--stroke-soft);
  }
  .arch-tech-label {
    font-size: 11.5px;
    color: var(--text-mute);
    font-family: var(--font-mono);
    white-space: nowrap;
    margin-right: 4px;
  }
  .arch-tech-tag {
    font-size: 11px;
    font-family: var(--font-mono);
    color: var(--text-dim);
    background: var(--glass-bg);
    border: 1px solid var(--stroke-soft);
    border-radius: var(--r-sm);
    padding: 3px 9px;
  }
</style>
